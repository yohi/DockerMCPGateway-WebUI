{
  "version": "1.0.0",
  "mcpServers": {
    "sample-server": {
      "command": "npx",
      "args": ["sample-mcp-server@latest"]
    },
    "docker-server": {
      "command": "docker",
      "args": ["run", "-it", "sample/mcp-server"]
    },
    "url-server": {
      "url": "https://api.example.com/mcp/",
      "headers": {
        "Authorization": "Bearer test-token"
      }
    },
    "env-server": {
      "command": "python",
      "args": ["-m", "sample_server"],
      "env": {
        "ENV_VAR1": "value1",
        "ENV_VAR2": "value2"
      }
    }
  }
}

{
  "mcpServers": {
    "docker-mcp-gateway": {
      "command": "docker",
      "args": [
        "exec",
        "-i",
        "mcp-gateway",
        "mcp-client",
        "--endpoint",
        "http://localhost:8080"
      ],
      "env": {
        "MCP_GATEWAY_HOST": "localhost",
        "MCP_GATEWAY_PORT": "18080"
      }
    }
  }
}

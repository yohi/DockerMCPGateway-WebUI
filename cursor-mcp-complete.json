{
  "description": "Cursor MCP設定 - DockerMCPGateway接続用",
  "mcpServers": {
    "docker-mcp-gateway-http": {
      "description": "HTTP transport経由でDockerMCPGatewayに接続",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/client@latest",
        "--transport",
        "http",
        "--url",
        "http://localhost:18080/mcp"
      ],
      "env": {
        "MCP_SERVER_URL": "http://localhost:18080/mcp",
        "MCP_TRANSPORT": "http",
        "NODE_ENV": "production"
      }
    },
    "docker-mcp-gateway-stdio": {
      "description": "STDIO transport経由でDockerMCPGatewayに接続（推奨）",
      "command": "docker",
      "args": [
        "exec",
        "-i",
        "mcp-gateway",
        "/docker-mcp",
        "gateway",
        "--stdio"
      ],
      "env": {
        "MCP_GATEWAY_CONTAINER": "mcp-gateway"
      }
    }
  }
}

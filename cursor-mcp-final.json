{
  "mcpServers": {
    "docker-mcp-gateway": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-stdio",
        "--",
        "curl",
        "-s",
        "-X",
        "POST",
        "-H",
        "Content-Type: application/json",
        "http://localhost:18080/mcp"
      ],
      "env": {
        "MCP_GATEWAY_URL": "http://localhost:18080/mcp",
        "MCP_TRANSPORT": "http"
      }
    }
  }
}

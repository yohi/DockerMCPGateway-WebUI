FROM node:20-alpine

WORKDIR /app

# 必要な依存関係を直接インストール
RUN npm install -g \
    next@14.1.0 \
    react@^18.2.0 \
    react-dom@^18.2.0 \
    @tanstack/react-query@^5.17.19 \
    axios@^1.6.5 \
    cors@^2.8.5 \
    express@^4.18.2 \
    node-fetch@^2.6.13 \
    socket.io@^4.7.4 \
    socket.io-client@^4.7.4 \
    tailwindcss@^3.4.1

# ソースコードをコピー
COPY src/ ./src/
COPY public/ ./public/

# 設定ファイルをコピー
COPY dev/tools/configs/next.config.js ./next.config.js
COPY dev/tools/configs/tailwind.config.js ./tailwind.config.js
COPY dev/tools/configs/postcss.config.js ./postcss.config.js
COPY dev/tools/configs/tsconfig.json ./tsconfig.json

# Next.jsアプリをビルド
RUN npx next build

# Next.jsを直接起動（package.json不要）
CMD ["npx", "next", "start"]

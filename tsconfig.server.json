{
    "compilerOptions": {
        "target": "es2016",
        "module": "commonjs",
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "src/server/**/*",
        "src/utils/**/*",
        "src/types/**/*"
    ],
    "exclude": [
        "node_modules",
        "src/app",
        "src/components",
        "src/pages",
        "src/api/socketClient.ts"
    ]
}

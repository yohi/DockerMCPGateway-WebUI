{
    "compilerOptions": {
        "target": "es2016",
        "module": "commonjs",
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "src/server/**/*"
    ],
    "exclude": [
        "node_modules",
        "src/app",
        "src/components",
        "src/pages"
    ]
}

FROM node:20-alpine

# 作業ディレクトリを設定
WORKDIR /app

# パッケージファイルをコピー
COPY package*.json ./

# 依存関係のインストール（開発用）
RUN npm install

# ソースコードをコピー
COPY . .

# 必要なディレクトリを作成
RUN mkdir -p /app/config

# ポートを公開
EXPOSE 5311

# 環境変数の設定
ENV NODE_ENV=development
ENV PORT=5311

# nodemonによる開発サーバー起動
CMD ["npm", "run", "dev:server"]

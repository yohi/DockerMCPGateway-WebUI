{
  "mcpServers": {
    "docker-mcp-gateway": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-client@latest",
        "--transport",
        "http",
        "--url",
        "http://localhost:18080"
      ],
      "env": {
        "MCP_SERVER_URL": "http://localhost:18080",
        "MCP_TRANSPORT": "http"
      }
    }
  }
}

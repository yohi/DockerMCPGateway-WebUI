{
  "name": "docker-mcp-web-gui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --config eslint.config.mjs",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "server": "tsx src/server/server.ts",
    "dev:server": "tsx watch src/server/server.ts",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.17.19",

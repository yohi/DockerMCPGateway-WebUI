FROM node:20-alpine AS base

# 作業ディレクトリを設定
WORKDIR /app

# パッケージマネージャーの最適化
RUN npm config set fund false && \
    npm config set audit false

# 依存関係のインストール（マルチステージ）
FROM base AS deps
COPY dev/tools/configs/package.json dev/tools/configs/package-lock.json* ./
RUN --mount=type=cache,target=/root/.npm \
    npm install --only=production

# ビルドステージ
FROM base AS builder
COPY dev/tools/configs/package.json dev/tools/configs/package-lock.json* ./
RUN --mount=type=cache,target=/root/.npm \
    npm install

# ソースファイルのみをコピー（必要なもののみ）
COPY src/ ./src/
COPY dev/tools/configs/tsconfig.server.json ./tsconfig.server.json

# TypeScriptをバックエンド専用でビルド
RUN npx tsc --project tsconfig.server.json

# 本番ステージ
FROM base AS runner

# Docker CLIとPython関連ツールをインストール
RUN apk add --no-cache docker-cli python3 py3-pip

# uvx (旧pipx) をインストール
RUN pip3 install --break-system-packages uv

# 非rootユーザーを作成
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 backend

WORKDIR /app

# 必要なファイルのみをコピー
COPY --from=deps --chown=backend:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=backend:nodejs /app/dist ./dist
COPY --from=builder --chown=backend:nodejs /app/package.json ./package.json

# npm設定を調整
RUN npm config set prefix /app/.npm-global

# MCPサーバーパッケージをグローバルインストール
RUN npm install -g @playwright/mcp @modelcontextprotocol/server-filesystem

# 環境設定
RUN echo 'export PATH=/app/.npm-global/bin:$PATH' >> /home/backend/.profile && \
    echo 'export PATH=/home/backend/.local/bin:$PATH' >> /home/backend/.profile

# 必要なディレクトリを作成
RUN mkdir -p /app/config /app/workspace /app/.npm-global && \
    chown -R backend:nodejs /app/config /app/workspace /app/.npm-global

USER backend

# ポートを公開
EXPOSE 5311

# 環境変数の設定
ENV NODE_ENV=production
ENV PORT=5311
ENV PATH=/app/.npm-global/bin:/home/backend/.local/bin:$PATH

# サーバーを起動
CMD ["node", "dist/server/server.js"]
